    "Metal cache cleared (%lld location(s)). Restart MetalGoose so shaders rebuild cleanly.": {
      "comment": "Number of cache directories cleared. Use the locale’s plural forms.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal cache cleared (%lld location). Restart MetalGoose to rebuild the shaders."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal cache cleared (%lld locations). Restart MetalGoose to rebuild the shaders."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal önbelleği %lld konumdan temizlendi. Gölgelendiricileri yeniden derlemek için MetalGoose’u yeniden başlatın."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal önbelleği %lld konumdan temizlendi. Gölgelendiricileri yeniden derlemek için MetalGoose’u yeniden başlatın."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal-Cache in %lld Ordner gelöscht. Starten Sie MetalGoose neu, um die Shader neu zu kompilieren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal-Cache in %lld Ordnern gelöscht. Starten Sie MetalGoose neu, um die Shader neu zu kompilieren."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La caché de Metal se borró de %lld ubicación. Reinicia MetalGoose para recompilar los sombreadores."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La caché de Metal se borró de %lld ubicaciones. Reinicia MetalGoose para recompilar los sombreadores."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Кэш Metal очищен в %lld папке. Перезапустите MetalGoose, чтобы заново скомпилировать шейдеры."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Кэш Metal очищен в %lld папках. Перезапустите MetalGoose, чтобы заново скомпилировать шейдеры."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Кэш Metal очищен в %lld папках. Перезапустите MetalGoose, чтобы заново скомпилировать шейдеры."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Кэш Metal очищен в %lld папках. Перезапустите MetalGoose, чтобы заново скомпилировать шейдеры."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 处的 Metal 缓存已清除。请重新启动 MetalGoose，以重新编译着色器。"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Metal のキャッシュを %lld か所で削除しました。MetalGoose を再起動してシェーダーを再コンパイルしてください。"
                }
              }
            }
          }
        },
        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld helyen töröltük a Metal gyorsítótárát. A shaderek újrafordításához indítsd újra a MetalGoose-t."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
