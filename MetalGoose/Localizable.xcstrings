    "A new version is available: %@\nWould you like to download and install it now?": {
      "comment": "Update body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is available: %@\nWould you like to download and install it now?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir sürüm mevcut: %@\nŞimdi indirip yüklemek ister misiniz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version ist verfügbar: %@\nMöchten Sie sie jetzt laden und installieren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una nueva versión disponible: %@\n¿Quieres descargarla e instalarla ahora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия: %@\nЗагрузить и установить её сейчас?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本可用：%@\n要立即下载并安装吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがあります：%@\n今すぐダウンロードしてインストールしますか？"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új verzió érhető el: %@\nSzeretnéd most letölteni és telepíteni?"
          }
        }
      }
    },
