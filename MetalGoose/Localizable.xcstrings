    "Target entered macOS fullscreen, which cannot be captured with the overlay. Please use windowed or borderless (windowed fullscreen) mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target entered macOS fullscreen, which cannot be captured with the overlay. Please use windowed or borderless (windowed fullscreen) mode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef pencere macOS tam ekran moduna geçti. Bu modda katmanlı yakalama kullanılamaz. Pencere modunu veya kenarlıksız pencere modunu kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielfenster ist im macOS-Vollbildmodus. Die Aufnahme mit Overlay ist in diesem Modus nicht möglich. Verwenden Sie den Fenstermodus oder ein randloses Vollbildfenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana de destino ha entrado en el modo de pantalla completa de macOS, que no admite la captura con la superposición. Utiliza el modo de ventana o una ventana sin bordes a pantalla completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целевое окно перешло в полноэкранный режим macOS, в котором захват с наложением недоступен. Используйте оконный режим или окно без рамки на весь экран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标窗口已进入 macOS 全屏模式，此模式下无法使用叠加层进行捕获。请使用窗口模式或无边框窗口全屏模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のウインドウが macOS のフルスクリーンモードになりました。このモードではオーバーレイを使ったキャプチャができません。ウインドウモード、またはボーダーレスの全画面ウインドウを使用してください。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A célablak a macOS teljes képernyős módjára váltott, amelyben az átfedő ablakos rögzítés nem használható. Válts ablakos módra vagy keret nélküli, teljes képernyős ablakra."
          }
        }
      }
    },
    "Target window not found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target window not found."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef pencere bulunamadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielfenster nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la ventana de destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целевое окно не найдено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到目标窗口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のウインドウが見つかりません。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A célablak nem található."
          }
        }
      }
    },
    "The downloaded update does not match the checksum GitHub published for it; refusing to install it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded update does not match the checksum GitHub published for it; refusing to install it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen güncellemenin sağlama toplamı GitHub’da yayımlanan değerle eşleşmediği için yükleme reddedildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfsumme des geladenen Updates stimmt nicht mit der von GitHub veröffentlichten Prüfsumme überein. Die Installation wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma de verificación de la actualización descargada no coincide con la publicada en GitHub. Se ha rechazado la instalación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма загруженного обновления не совпадает с опубликованной на GitHub. Установка отклонена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新与 GitHub 发布的校验和不一致，已拒绝安装。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアップデートのチェックサムが GitHub で公開されている値と一致しないため、インストールを中止しました。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltött frissítés ellenőrzőösszege nem egyezik a GitHubon közzétett értékkel, ezért a telepítést elutasítottuk."
          }
        }
      }
    },
